model CustomerVehicle {
  id              String    @id @default(cuid())
  customerId      String
  brand           String
  model           String
  version         String?
  year            String?
  plate           String?
  vin             String?
  purchaseDate    DateTime?
  deliveryDate    DateTime?
  purchasePrice   Int?
  financingType   String?
  executive       String?
  observations    String?
  createdAt       DateTime  @default(now())
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_vehicles")
}

model CustomerInterest {
  id          String    @id @default(cuid())
  customerId  String
  brandId     String?
  modelId     String?
  versionId   String?
  brandName   String?
  modelName   String?
  versionName String?
  source      String?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  version     Version?  @relation(fields: [versionId], references: [id])

  @@map("customer_interests")
}

model Activity {
  id          String    @id @default(cuid())
  customerId  String
  type        String
  description String
  activityAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Reminder {
