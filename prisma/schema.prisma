generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String         @id @default(cuid())
  name      String         @unique
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]
  versions  Version[]
  documents Document[]

  @@map("brands")
}

model AppUser {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  passwordHash  String
  role          String               @default("ADMIN")
  status        String               @default("ACTIVO")
  lastLoginAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  resetTokens   PasswordResetToken[]

  @@map("app_users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model VehicleModel {
  id                 String               @id @default(cuid())
  brandId            String
  name               String
  segment            String?
  canonicalSegment   String?              // SEDAN | SUV | PICKUP | HATCHBACK | CITYCAR | COMERCIAL
  fuelTypes          String?

  transmissions      String?
  tractions          String?
  imagePath          String?
  technicalSheetId   String?
  commercialPosition Int                  @default(0)
  status             String               @default("BORRADOR")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  brand              Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  technicalSheet     Document?            @relation("ModelTechnicalSheet", fields: [technicalSheetId], references: [id])
  versions           Version[]
  campaigns          CommercialCampaign[]

  @@unique([brandId, name])
  @@map("models")
}

model Version {
  id                 String             @id @default(cuid())
  brandId            String
  modelId            String
  name               String
  sapCode            String?
  modelYear          String?
  engine             String?
  displacement       String?
  turbo              Boolean?
  power              String?
  torque             String?
  transmission       String?
  gears              String?
  traction           String?
  fuelType           String?
  consumption        String?
  autonomy           String?
  passengers         String?
  cargoCapacity      String?
  wheels             String?
  screen             String?
  carPlay            String?
  androidAuto        String?
  camera             String?
  sensors            String?
  roof               String?
  seats              String?
  climateControl     String?
  airbags            String?
  adas               String?
  cruiseControl      String?
  equipmentSummary   String?
  safetySummary      String?
  warranty           String?
  observations       String?
  commercialOrder    Int                @default(0)
  status             String             @default("BORRADOR")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  brand              Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model              VehicleModel       @relation(fields: [modelId], references: [id], onDelete: Restrict)
  prices             Price[]
  priceHistory       PriceHistory[]
  campaigns          CommercialCampaign[]
  bonuses            Bonus[]
  benefits           Benefit[]
  quoteItems         QuoteItem[]
  interests          CustomerInterest[]
  commercialOffers   CommercialOffer[]
  socialPosts        SocialPost[]

  @@unique([modelId, name])
  @@map("versions")
}

model Price {
  id            String         @id @default(cuid())
  versionId     String
  priceType     String
  amount        Int
  currency      String         @default("CLP")
  channel       String         @default("REGULAR")  // REGULAR | DERCO_CL | PREVENTA | CONCESIONARIO
  bonusName     String?        // e.g. "Bono Días 0 Km"
  bonusAmount   Int?           // monto del bono incluido en este precio
  hasIva        Boolean        @default(false)       // true = el monto es +IVA (sin incluir)
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  // Bloque B: periodo comercial al que pertenece este precio, "AAAA-MM"
  // (ej. "2026-09"). En automotriz la lista rige por mes: la de agosto
  // deja de valer cuando empieza septiembre, aunque nadie la desactive.
  // Es texto y no fecha a proposito: es una etiqueta de periodo, no un
  // instante. Ver src/lib/mes-comercial.ts.
  mesComercial  String?
  status        String         @default("DETECTADO")
  sourceId      String?
  documentId    String?
  approvedBy    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  version       Version        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  document      Document?      @relation(fields: [documentId], references: [id])
  source        Update?        @relation(fields: [sourceId], references: [id])
  history       PriceHistory[]

  @@index([versionId, priceType, status])
  @@index([versionId, channel])
  @@index([mesComercial])
  @@index([versionId, mesComercial])
  @@map("prices")
}

model PriceHistory {
  id             String   @id @default(cuid())
  versionId      String
  priceId        String?
  priceType      String
  previousAmount Int?
  newAmount      Int
  difference     Int?
  changedAt      DateTime @default(now())
  sourceName     String?
  sourceId       String?
  approvedBy     String?
  observation    String?
  version        Version  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  price          Price?   @relation(fields: [priceId], references: [id])

  @@map("price_history")
}

model CommercialCampaign {
  id              String        @id @default(cuid())
  brandId         String?
  modelId         String?
  versionId       String?
  title           String
  promotionType   String
  condition       String?
  exception       String?
  benefit         String?
  startDate       DateTime?
  endDate         DateTime?
  status          String        @default("BORRADOR")
  sourceId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  model           VehicleModel? @relation(fields: [modelId], references: [id])
  version         Version?      @relation(fields: [versionId], references: [id])

  @@map("commercial_campaigns")
}

model Bonus {
  id          String   @id @default(cuid())
  brandId     String?
  modelId     String?
  versionId   String?
  name        String
  amount      Int?
  conditions  String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("BORRADOR")
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Version? @relation(fields: [versionId], references: [id])

  @@map("bonuses")
}

model Benefit {
  id          String   @id @default(cuid())
  brandId     String?
  modelId     String?
  versionId   String?
  name        String
  appliesTo   String?
  exception   String?
  conditions  String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("BORRADOR")
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Version? @relation(fields: [versionId], references: [id])

  @@map("benefits")
}

model Document {
  id             String           @id @default(cuid())
  brandId        String?
  type           String
  originalName   String
  storedPath     String?
  mimeType       String?
  extension      String?
  textSource     String?
  receivedAt     DateTime         @default(now())
  status         String           @default("DETECTADO")
  brand          Brand?           @relation(fields: [brandId], references: [id])
  imports        DocumentImport[]
  prices         Price[]
  vehicleModels  VehicleModel[]   @relation("ModelTechnicalSheet")

  @@map("documents")
}

model DocumentImport {
  id             String               @id @default(cuid())
  documentId     String?
  importType     String
  status         String               @default("EN_REVISION")
  detectedBrand  String?
  detectedMonth  String?
  summaryJson    String?
  createdAt      DateTime             @default(now())
  document       Document?            @relation(fields: [documentId], references: [id])
  extractions    DocumentExtraction[]

  @@map("document_imports")
}

model DocumentExtraction {
  id          String         @id @default(cuid())
  importId    String
  category    String
  rawText     String
  payloadJson String?
  confidence  String         @default("REQUIERE_REVISION")
  status      String         @default("DETECTADO")
  import      DocumentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("document_extractions")
}

model Update {
  id          String       @id @default(cuid())
  title       String
  sourceType  String
  documentId  String?
  rawText     String?
  status      String       @default("DETECTADO")
  createdAt   DateTime     @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  items       UpdateItem[]
  prices      Price[]

  @@map("updates")
}

model UpdateItem {
  id              String   @id @default(cuid())
  updateId        String
  category        String
  brandName       String?
  modelName       String?
  versionName     String?
  fieldName       String?
  previousValue   String?
  proposedValue   String?
  amount          Int?
  rawText         String
  confidence      String   @default("REQUIERE_REVISION")
  status          String   @default("DETECTADO")
  ambiguityReason String?
  payloadJson     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  update          Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@map("update_items")
}

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String?
  brandName     String?
  modelName     String?
  versionName   String?
  fieldModified String
  previousValue String?
  newValue      String?
  source        String?
  user          String?
  observation   String?
  createdAt     DateTime @default(now())

  @@map("audit_log")
}

model Acronym {
  id          String   @id @default(cuid())
  code        String   @unique
  meaning     String?
  description String?
  source      String   @default("DEFINIDO_MANUALMENTE")
  status      String   @default("VIGENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("acronyms")
}

model CustomerStatus {
  id        String     @id @default(cuid())
  name      String     @unique
  stage     String?
  position  Int        @default(0)
  active    Boolean    @default(true)
  customers Customer[]

  @@map("customer_statuses")
}

model CustomerOrigin {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  customers Customer[]

  @@map("customer_origins")
}

model Customer {
  id                 String             @id @default(cuid())
  firstName          String
  lastName           String?
  rut                String?
  phone              String?
  whatsapp           String?
  email              String?
  birthDate          DateTime?
  address            String?
  commune            String?
  city               String?
  region             String?
  emailVerifiedAt    DateTime?
  emailVerificationToken String?        @unique
  rutLookupConsentAt DateTime?
  rutLookupSource    String?
  statusId           String?
  originId           String?
  interestedBrand    String?
  interestedModel    String?
  interestedVersion  String?
  budget             Int?
  purchaseType       String?
  currentVehicle     String?
  currentPlate       String?
  notes              String?
  lastContactAt      DateTime?
  nextActionType     String?
  nextActionAt       DateTime?
  nextActionNote     String?
  nextActionPriority String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  status             CustomerStatus?    @relation(fields: [statusId], references: [id])
  origin             CustomerOrigin?    @relation(fields: [originId], references: [id])
  vehicles           CustomerVehicle[]
  interests          CustomerInterest[]
  activities         Activity[]
  reminders          Reminder[]
  credits            CreditContract[]
  quotes             Quote[]
