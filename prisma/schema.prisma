  purchaseDate        DateTime?
  creditStartDate     DateTime?
  installments        Int?
  firstInstallmentDate DateTime?
  lastInstallmentDate DateTime?
  endDateSource       String?
  financedAmount      Int?
  downPayment         Int?
  installmentAmount   Int?
  rate                String?
  cae                 String?
  creditType          String?
  observations        String?
