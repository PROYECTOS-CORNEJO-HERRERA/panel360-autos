// ─── Motor de Inteligencia Comercial ────────────────────────────────────────

/// Registra TODA oferta comercial extraída de los Excel (bonos, patente gratis,
/// tasas, giftcards, bono cierre compartido, precios Derco.cl, preventas).
/// Reemplaza la dispersión actual entre CommercialCampaign, Bonus y Benefit.
model CommercialOffer {
  id               String    @id @default(cuid())
  /// Tipo de oferta comercial
  offerType        String    // BONO_MARCA | BONO_FINANCIAMIENTO | BONO_CIERRE_COMPARTIDO |
                             // PATENTE_GRATIS | TASA | GIFTCARD | PRECIO_ESPECIAL |
                             // MANTENCION | ACCESORIO | PREVENTA | COPEC | OTRO
  brandId          String?
  modelId          String?
  versionId        String?
  /// Nombres descriptivos para búsqueda rápida sin join
  brandName        String?
  modelName        String?
  versionName      String?
  title            String    // Nombre del beneficio, ej: "Bono Días 0 Km"
  /// Canal de venta donde aplica
  channel          String    @default("REGULAR") // REGULAR | DERCO_CL | PREVENTA | CONCESIONARIO | WEB
  /// Tipo de pago para el que aplica la oferta
  paymentType      String    @default("AMBOS")   // CONTADO | CREDITO | AMBOS
  /// Montos diferenciados por tipo de pago
  amountCash       Int?      // monto para negocios al contado
  amountCredit     Int?      // monto para negocios con crédito
  amountTotal      Int?      // monto único si no se diferencia
  /// Para Bono Cierre Compartido: desglose de origen del fondo
  aporteCES        Int?      // aporte de CES (concesionario)
  aporteMarca      Int?      // aporte de la marca
  aporteCESCredit  Int?      // aporte CES para crédito
  aporteMarcaCredit Int?     // aporte marca para crédito
  /// IVA
  hasIva           Boolean   @default(false) // true = montos son +IVA (sin incluir)
  /// Tasas
  rate             String?   // ej: "1.69%"
  rateContext      String?   // ej: "Tasa GWM Amicar comisión subvencionada"
  /// Vigencia
  validFrom        DateTime?
  validUntil       DateTime?
  /// Reglas de compatibilidad/incompatibilidad (texto libre, parseable)
  condition        String?   // descripción general de la condición
  incompatibleWith String?   // ej: "TASA_1.69_GWM_AMICAR, TASA_0.99_POER_P500"
  compatibleWith   String?   // ej: "BONO_CIERRE_COMPARTIDO, TASA_1.69, CAMPANAS"
  exception        String?   // excepciones específicas
  /// Trazabilidad de origen
  sourceDocumentId String?
  sheetName        String?   // hoja del Excel de origen, ej: "Bono Cierre Compartido"
  sourceMonth      String?   // texto libre tal como venia en el documento, ej: "agosto 2026"
  // Bloque B: el mismo mes en formato normalizado "AAAA-MM", que es el
  // que se puede filtrar y ordenar. `sourceMonth` existia desde antes
  // pero ningun codigo lo leia ni lo escribia.
  mesComercialNormalizado String?
  /// Estado del ciclo de vida
  status           String    @default("VIGENTE") // VIGENTE | FINALIZADA | BORRADOR | SUSPENDIDA
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Version?  @relation(fields: [versionId], references: [id])

  @@index([versionId, offerType, status])
  @@index([modelName, offerType, status])
  @@index([status, validUntil])
  @@map("commercial_offers")
}

model ProfitabilitySheet {
  id             String   @id @default(cuid())
  versionId      String?
  vehicleLabel   String
  customerName   String?
  customerEmail  String?
  orderNumber    String?
  internalNumber String?
  invoiceDate    String?
  salePrice      Int?
  marginTotal    Int?
  data           String
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@map("profitability_sheets")
}

// ============================================================
// BLOQUE F: PUBLICACIONES A INSTAGRAM
// ============================================================
//
// Se publica SOLO por la API oficial de Meta (Instagram Graph API).
// Automatizar la app con usuario y clave (instagrapi y similares) esta
// descartado a proposito: funciona hasta que Meta lo detecta y cierra
// la cuenta. Una cuenta que representa a la marca no se arriesga asi.
//
// Consecuencias de usar la via oficial, que este modelo asume:
//   - La cuenta debe ser Business y estar ligada a una Pagina.
//   - Las imagenes deben estar en una URL publica: Instagram las
//     descarga desde su servidor, no se suben por multipart.
//   - Publicar son dos pasos (crear contenedor, luego publicarlo), y
//     el primero puede quedar procesando varios segundos.
//   - Hay tope de 25 publicaciones cada 24 horas por cuenta.

model SocialAccount {
  id            String   @id @default(cuid())
  provider      String   @default("INSTAGRAM")
  // Nombre visible, para no depender de la API solo para saber cual es.
  username      String?
  // ID de la cuenta Instagram Business dentro del grafo de Meta.
  igUserId      String?
  // Token cifrado (AES-256-GCM). Nunca en claro, ni en base ni en logs.
  // Ver src/lib/social/secretos.ts.
  tokenCifrado  String?
  // Cuando caduca el token de larga duracion (~60 dias). Se renueva
  // solo mientras se use; si nadie publica en 60 dias, muere.
  tokenExpiraEn DateTime?
  // Si true, ninguna publicacion sale sin aprobacion humana explicita.
  requiereAprobacion Boolean @default(true)
  connectedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         SocialPost[]

  @@unique([provider])
  @@map("social_accounts")
}

model SocialPost {
  id            String   @id @default(cuid())
  accountId     String?
  // FEED | CARRUSEL | REEL | STORY
  formato       String   @default("FEED")
  // BORRADOR | PENDIENTE_APROBACION | PROGRAMADO | PUBLICANDO | PUBLICADO | ERROR | CANCELADO
  estado        String   @default("BORRADOR")
  // Plantilla que lo origino (LANZAMIENTO | BAJA_PRECIO | STOCK | FIN_DE_MES | LIBRE)
  plantilla     String   @default("LIBRE")
  caption       String
  // Vehiculo de origen, si el post nacio del catalogo. Opcional a
  // proposito: tambien se escriben posts sueltos.
  versionId     String?
  // Snapshot del precio al momento de redactar. Si el precio cambia
  // entre que se redacta y que se publica, el caption ya no dice la
  // verdad -- por eso se guarda y se vuelve a comparar antes de salir.
  precioSnapshot Int?
  mesComercial  String?
  programadoPara DateTime?
  publicadoEn   DateTime?
  // ID del post ya publicado en Instagram, para poder enlazarlo.
  igMediaId     String?
  igPermalink   String?
  error         String?
  intentos      Int      @default(0)
  aprobadoPor   String?
  aprobadoEn    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  account       SocialAccount? @relation(fields: [accountId], references: [id])
  version       Version?       @relation(fields: [versionId], references: [id])
  medias        SocialPostMedia[]

  @@index([estado, programadoPara])
  @@index([versionId])
  @@map("social_posts")
}

model SocialPostMedia {
  id        String   @id @default(cuid())
  postId    String
  // URL PUBLICA. Instagram descarga desde aqui; un blob privado o un
  // localhost no sirven.
  url       String
  tipo      String   @default("IMAGEN") // IMAGEN | VIDEO
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, orden])
  @@map("social_post_medias")
}
